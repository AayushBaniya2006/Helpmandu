# Helpmandu Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# ===========================================
# FIREBASE CONFIGURATION
# ===========================================
# Get these from Firebase Console > Project Settings

# Web
FIREBASE_WEB_API_KEY=your_web_api_key_here
FIREBASE_WEB_APP_ID=your_web_app_id_here
FIREBASE_WEB_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_WEB_PROJECT_ID=your_project_id
FIREBASE_WEB_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_WEB_STORAGE_BUCKET=your_project.appspot.com

# Android
FIREBASE_ANDROID_API_KEY=your_android_api_key_here
FIREBASE_ANDROID_APP_ID=your_android_app_id_here

# iOS
FIREBASE_IOS_API_KEY=your_ios_api_key_here
FIREBASE_IOS_APP_ID=your_ios_app_id_here
FIREBASE_IOS_CLIENT_ID=your_ios_client_id_here
FIREBASE_IOS_ANDROID_CLIENT_ID=your_android_client_id_here
FIREBASE_IOS_BUNDLE_ID=com.example.helpmandu

# macOS
FIREBASE_MACOS_API_KEY=your_macos_api_key_here
FIREBASE_MACOS_APP_ID=your_macos_app_id_here
FIREBASE_MACOS_CLIENT_ID=your_macos_client_id_here
FIREBASE_MACOS_BUNDLE_ID=com.example.helpmandu.RunnerTests

# ===========================================
# PAYMENT GATEWAY CONFIGURATION
# ===========================================

# eSewa (Get from eSewa Merchant Portal)
ESEWA_MERCHANT_ID=EPAYTEST
ESEWA_SECRET_KEY=your_esewa_secret_key

# Khalti (Get from Khalti Merchant Dashboard)
KHALTI_PUBLIC_KEY=your_khalti_public_key
KHALTI_SECRET_KEY=your_khalti_secret_key

# ===========================================
# APP CONFIGURATION
# ===========================================

# Service Provider Contact
DEFAULT_PROVIDER_PHONE=+9779800000000
DEFAULT_PROVIDER_EMAIL=support@helpmandu.com

# Firebase App Check (Get from Google Cloud Console)
RECAPTCHA_V3_SITE_KEY=your_recaptcha_site_key

# ===========================================
# ENVIRONMENT
# ===========================================
ENVIRONMENT=development
# Options: development, staging, production
